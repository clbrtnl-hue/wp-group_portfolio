{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1320px",
      "wideSize": "1560px"
    },
    "color": {
      "custom": true,
      "customGradient": true,
      "customDuotone": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "lime", "color": "#C8F14D", "name": "Lime" },
        { "slug": "lime-deep", "color": "#B2DF33", "name": "Lime Deep" },
        { "slug": "ink", "color": "#101110", "name": "Ink" },
        { "slug": "graphite", "color": "#2B2C2A", "name": "Graphite" },
        { "slug": "slate", "color": "#6E7269", "name": "Slate" },
        { "slug": "mist", "color": "#F2F3EF", "name": "Mist" },
        { "slug": "line", "color": "#E3E5DE", "name": "Line" },
        { "slug": "shell", "color": "#FFFFFF", "name": "Shell" }
      ],
      "gradients": [
        { "slug": "mist-fade", "name": "Mist Fade", "gradient": "linear-gradient(135deg, #F2F3EF 0%, #E3E5DE 100%)" },
        { "slug": "lime-fade", "name": "Lime Fade", "gradient": "linear-gradient(135deg, #C8F14D 0%, #B2DF33 100%)" }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "customLineHeight": true,
      "dropCap": false,
      "lineHeight": true,
      "fontWeight": true,
      "textTransform": true,
      "letterSpacing": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Space Grotesk\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "slug": "space-grotesk",
          "name": "Space Grotesk",
          "fontFace": [
            {
              "fontFamily": "Space Grotesk",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/SpaceGrotesk-Variable.ttf"]
            }
          ]
        },
        {
          "fontFamily": "\"Inter Tight\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "slug": "inter-tight",
          "name": "Inter Tight",
          "fontFace": [
            {
              "fontFamily": "Inter Tight",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/InterTight-Variable.ttf"]
            },
            {
              "fontFamily": "Inter Tight",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/InterTight-Italic-Variable.ttf"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "d1", "name": "Display 1", "size": "clamp(46px, 9.2vw, 120px)", "fluid": false },
        { "slug": "d2", "name": "Display 2", "size": "clamp(30px, 4.6vw, 58px)", "fluid": false },
        { "slug": "d3", "name": "Display 3", "size": "clamp(25px, 3vw, 40px)", "fluid": false },
        { "slug": "d4", "name": "Display 4", "size": "clamp(19px, 1.7vw, 25px)", "fluid": false },
        { "slug": "lead", "name": "Lead", "size": "clamp(16px, 1.25vw, 19px)", "fluid": false },
        { "slug": "body", "name": "Body", "size": "16px", "fluid": false },
        { "slug": "small", "name": "Small", "size": "14.6px", "fluid": false },
        { "slug": "mini", "name": "Mini", "size": "13px", "fluid": false },
        { "slug": "eyebrow", "name": "Eyebrow", "size": "12px", "fluid": false },
        { "slug": "card-title", "name": "Card Title", "size": "20px", "fluid": false },
        { "slug": "stat", "name": "Stat", "size": "clamp(38px, 5.4vw, 64px)", "fluid": false }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "spacingSizes": [
        { "slug": "10", "name": "1", "size": "6px" },
        { "slug": "20", "name": "2", "size": "10px" },
        { "slug": "30", "name": "3", "size": "16px" },
        { "slug": "40", "name": "4", "size": "22px" },
        { "slug": "50", "name": "5", "size": "30px" },
        { "slug": "60", "name": "6", "size": "clamp(34px, 4vw, 58px)" },
        { "slug": "70", "name": "7", "size": "clamp(44px, 5vw, 72px)" },
        { "slug": "80", "name": "8", "size": "clamp(64px, 7vw, 110px)" }
      ]
    },
    "border": { "color": true, "radius": true, "width": true, "style": true },
    "shadow": {
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 40px 80px -50px rgba(16,17,16,.55), 0 0 0 1px #E3E5DE" },
        { "slug": "lift", "name": "Lift", "shadow": "0 28px 56px -40px rgba(16,17,16,.6)" },
        { "slug": "badge", "name": "Badge", "shadow": "0 14px 30px -18px rgba(16,17,16,.7)" }
      ]
    },
    "dimensions": { "minHeight": true, "aspectRatio": true },
    "position": { "sticky": true },
    "custom": {
      "radius": {
        "sm": "10px",
        "md": "18px",
        "lg": "26px",
        "pill": "999px"
      },
      "ease": "cubic-bezier(.22,.61,.36,1)",
      "section": "clamp(64px, 7vw, 110px)"
    },
    "core/navigation": { "spacing": { "margin": true, "padding": true } }
  },
  "styles": {
    "color": {
      "text": "var(--wp--preset--color--ink)",
      "background": "var(--wp--preset--color--lime)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter-tight)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.62",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "0px"
    },
    "elements": {
      "heading": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
          "fontWeight": "700",
          "lineHeight": "1.06",
          "letterSpacing": "-0.028em"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--d1)", "lineHeight": "0.9", "letterSpacing": "-0.042em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--d2)", "lineHeight": "1.02", "letterSpacing": "-0.032em" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--d3)", "lineHeight": "1.1", "letterSpacing": "-0.028em" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--d4)", "lineHeight": "1.2", "letterSpacing": "-0.02em" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--card-title)", "lineHeight": "1.26", "letterSpacing": "-0.024em" } },
      "h6": { "typography": { "fontSize": "var(--wp--preset--font-size--body)", "lineHeight": "1.35", "letterSpacing": "-0.01em" } },
      "link": {
        "color": { "text": "inherit" },
        "typography": { "textDecoration": "none" },
        ":hover": { "typography": { "textDecoration": "none" } }
      },
      "caption": {
        "color": { "text": "var(--wp--preset--color--slate)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--mini)" }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
          "fontSize": "15px",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em",
          "textTransform": "none"
        },
        "color": {
          "background": "var(--wp--preset--color--lime)",
          "text": "var(--wp--preset--color--ink)"
        },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "13px", "bottom": "13px", "left": "26px", "right": "26px" } },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--lime-deep)",
            "text": "var(--wp--preset--color--ink)"
          }
        }
      }
    },
    "blocks": {
      "core/template-part": { "spacing": { "margin": { "top": "0", "bottom": "0" } } },
      "core/separator": { "color": { "text": "var(--wp--preset--color--line)" } },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
          "fontWeight": "700",
          "letterSpacing": "-0.028em"
        }
      },
      "core/query-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
          "fontWeight": "700",
          "letterSpacing": "-0.032em"
        }
      },
      "core/navigation-link": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter-tight)",
          "fontSize": "15px",
          "fontWeight": "500"
        }
      },
      "core/quote": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--space-grotesk)" },
        "border": { "left": { "color": "var(--wp--preset--color--lime)", "width": "3px", "style": "solid" } },
        "spacing": { "padding": { "left": "24px" } }
      },
      "core/pullquote": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--space-grotesk)" }
      },
      "core/code": {
        "color": { "background": "var(--wp--preset--color--mist)" },
        "border": { "radius": "12px" },
        "spacing": { "padding": { "top": "20px", "bottom": "20px", "left": "22px", "right": "22px" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": []
}
